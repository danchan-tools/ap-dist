# ===================================================================
# 環境変数の見本。
#
# このファイルを .env.local という名前でコピーして、値を入れる。
# .env.local は .gitignore で除外されているので、GitHub には上がらない。
#
# 🔴 このファイル（.env.example）には、本物の値を書かないこと。
#    ここは Git に上がる。
#
# Vercel に公開するときは、同じ3つを
# Vercel の Settings → Environment Variables にも登録する。
# ===================================================================

# Neon（PostgreSQL）の接続文字列
# Neon の管理画面 → Connection string からコピーする
DATABASE_URL=

# ログイン用のパスワード（F-1）。好きな文字列でよい
APP_PASSWORD=

# セッション Cookie の署名に使う秘密の文字列
# 適当な長い文字列でよい。作り方：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Claude API のキー（F-10 まとめ書き用）。着手するまでは空でよい
ANTHROPIC_API_KEY=
